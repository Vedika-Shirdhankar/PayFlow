PORT=5000
# Transactions REQUIRE a replica set (or Atlas). Start MongoDB locally in replica-set mode before running the app.
MONGO_URI=mongodb://127.0.0.1:27017/payflow?replicaSet=rs0&directConnection=true
# REQUIRED, min 16 chars. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:5173

# Redis Configuration (BullMQ Queue + realtime pub/sub)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# Or use a Redis URL (takes precedence over host/port):
# REDIS_URL=redis://default:password@localhost:6379

# Worker Configuration
WORKER_ID=
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL=2000
WORKER_HEARTBEAT_TIMEOUT=6000
RECONCILE_INTERVAL_MS=30000

# BullMQ Retry Configuration
MAX_JOB_ATTEMPTS=3
RETRY_BACKOFF_DELAY_MS=2000

# Demo Configuration (admin dashboard can change these at runtime)
DEMO_PROCESSING_DELAY_MS=5000
SIMULATE_ONE_FAILURE=false

# Limits
MAX_PAYMENT_AMOUNT=100000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
